# Единый конфиг БЕЗТЕЛ. Скопируйте в .env и заполните свои значения:
#   copy .env.example .env          (Windows)
#   cp .env.example .env            (Linux / macOS)
# Файл .env в git не попадает.

# --- Telegram-бот (BotFather) ---
# Токен вида 123456789:AAH...
BOT_TOKEN=
# Имя бота без @
BOT_USERNAME=
# Куда бот ведёт ученика. Для кнопки внутри Telegram нужен https-адрес.
MINI_APP_URL=http://127.0.0.1:8000
PLATFORM_API_URL=http://127.0.0.1:8000/api/v1

# --- Сайт ---
app_name=Башкирская языковая школа
debug=false

# Секрет подписи входа. На сервере замените длинной случайной строкой.
secret_key=change-me-to-a-long-random-string
algorithm=HS256
access_token_expire_minutes=10080

# То же имя бота читает и сайт.
bot_username=

# --- PostgreSQL ---
# Локально и при `docker compose up -d` хост — 127.0.0.1.
# В полном docker compose хост подменяется на db автоматически.
database_url=postgresql+asyncpg://bashkar:bashkar@127.0.0.1:5432/bashkar
db_echo=false

# --- Чат с носителем (Groq, OpenAI-совместимый API) ---
llm_api_base_url=https://api.groq.com/openai/v1/chat/completions
llm_model=openai/gpt-oss-120b
llm_api_key=
llm_timeout=90

# --- Озвучка и распознавание ---
# Модели скачиваются при первом запросе в hf_home.
tts_model=facebook/mms-tts-bak
asr_model=AigizK/GigaAM-Bashkir-CV25-ONNX
hf_home=.cache/huggingface

# Пути относительно корня проекта.
data_dir=data
static_dir=backend/static
frontend_dir=frontend
dataset_file=data/phrasebooks.jsonl

# --- Геймификация ---
hearts_max=5
hearts_refill_seconds=3600
daily_cards_goal=20
xp_per_correct=10
xp_per_speed_correct=15
xp_per_duel_win=30
