# Конфигурация «Башкирская языковая школа» (backend)

# --- PostgreSQL (слой данных) ---
DATABASE_URL=postgresql+asyncpg://bashkar:bashkar@127.0.0.1:5432/bashkar

# --- LLM (OpenAI-совместимый) ---
LLM_API_BASE_URL=https://api.groq.com/openai/v1/chat/completions
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=gsk_your_groq_key_here

# --- TTS / ASR ---
TTS_MODEL=facebook/mms-tts-bak
ASR_MODEL=AigizK/GigaAM-Bashkir-CV25-ONNX
HF_HOME=D:/hf-cache

# --- Файлы ---
DATA_DIR=D:/goRofls/_Projects/bashkar/data
STATIC_DIR=D:/goRofls/_Projects/bashkar/backend/static
DATASET_FILE=D:/goRofls/_Projects/bashkar/data/phrasebooks.jsonl

# --- Геймификация ---
HEARTS_MAX=5
HEARTS_REFILL_SECONDS=3600
DAILY_CARDS_GOAL=20
